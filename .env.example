# Todos estos valores son públicos: terminan en el JavaScript del navegador.
VITE_SHOPIFY_DOMAIN=escaleranfc.myshopify.com
VITE_SHOPIFY_API_VERSION=2026-10
VITE_SHOPIFY_PRODUCT_HANDLE=tarjetas-nfc
# Solo si la API llega a pedir token. Siempre un token PÚBLICO de Storefront, nunca uno privado.
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Formato wa.me: código de país + número, sin "+", espacios ni el "1" viejo de México.
VITE_WHATSAPP_NUMBER=522286461167
